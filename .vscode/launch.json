{
    "version": "0.2.0",
    "configurations": [
        {
            // F5 または「Run」で Mini Shop を起動する。http://localhost:8080/
            // DB接続先やポートは config/app.properties で変える（README参照）
            "type": "java",
            "name": "Mini Shop",
            "request": "launch",
            "mainClass": "shop.Main",
            "preLaunchTask": "build",
            "classPaths": [
                "${workspaceFolder}/out/classes",
                "${workspaceFolder}/lib/postgresql-42.7.4.jar"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
